# ============================================
# NIFTY Auto Trader 3.0 — Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env with real credentials.

# ---- Application ----
NODE_ENV=development
APP_ENV=development
APP_VERSION=3.0.0

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="NIFTY Auto Trader"

# ---- Supabase Auth ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Backend (FastAPI) ----
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_SECRET_KEY=generate-a-secure-random-key-here
API_CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/autotrader
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Kotak Neo Broker ----
KOTAK_NEO_CONSUMER_KEY=your-consumer-key
KOTAK_NEO_CONSUMER_SECRET=your-consumer-secret
KOTAK_NEO_MOBILE_NUMBER=your-registered-mobile
KOTAK_NEO_PASSWORD=your-password
# TOTP is entered at login time, NEVER stored
# KOTAK_NEO_MPIN is entered at login time if required

# ---- Redis (Optional, for caching/pub-sub) ----
REDIS_URL=redis://localhost:6379/0

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Security ----
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=60
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
